{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/breakstring/cfKanban/release/bootstrap/release-manifest.schema.json",
  "title": "cfKanban immutable release manifest",
  "type": "object",
  "required": ["schema_version", "product", "publisher", "release", "compatibility", "artifacts", "documents"],
  "properties": {
    "schema_version": { "const": 1 },
    "product": { "const": "cfkanban" },
    "publisher": { "type": "object" },
    "release": {
      "type": "object",
      "required": ["version", "immutable"],
      "properties": {
        "version": { "type": "string" },
        "immutable": { "const": true }
      },
      "additionalProperties": false
    },
    "compatibility": { "type": "object" },
    "artifacts": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": ["kind", "version", "url", "allowed_origins", "sha256"],
        "properties": {
          "kind": { "enum": ["skill_bundle", "service_deployment_bundle"] },
          "version": { "type": "string" },
          "url": { "type": "string", "format": "uri", "pattern": "^https://" },
          "allowed_origins": { "type": "array", "minItems": 1, "items": { "type": "string", "format": "uri", "pattern": "^https://" } },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "additionalProperties": false
      }
    },
    "documents": { "type": "object" }
  },
  "additionalProperties": false
}
