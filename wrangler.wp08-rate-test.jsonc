{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cfkanban-wp08-rate-test",
  "main": "apps/worker/src/index.ts",
  "compatibility_date": "2026-08-29",
  "assets": {
    "directory": "./apps/web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/healthz",
      "/openapi.json",
      "/invite",
      "/app/launch",
      "/.well-known/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cfkanban-wp08-rate-test",
      "database_id": "00000000-0000-0000-0000-000000000008",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "PRINCIPAL_RATE_LIMITER",
      "namespace_id": "8001",
      "simple": { "limit": 120, "period": 60 }
    },
    {
      "name": "INSTANCE_RATE_LIMITER",
      "namespace_id": "8002",
      "simple": { "limit": 300, "period": 60 }
    },
    {
      "name": "UNAUTHENTICATED_RATE_LIMITER",
      "namespace_id": "8003",
      "simple": { "limit": 30, "period": 60 }
    }
  ]
}
