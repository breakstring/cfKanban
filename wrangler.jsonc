{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cfkanban",
  "main": "apps/worker/src/index.ts",
  "compatibility_date": "2026-08-29",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "assets": {
    "directory": "./apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": [
      "/api/*",
      "/healthz",
      "/openapi.json",
      "/invite",
      "/",
      "/app",
      "/app/*",
      "/llms.txt",
      "/robots.txt",
      "/robots.txt/*",
      "/sitemap.xml",
      "/sitemap.xml/*",
      "/agent-skills",
      "/agent-skills/*",
      "/docs",
      "/docs/*",
      "/.well-known/*",
      "!/docs/assets/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cfkanban-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "RATE_LIMIT_INSTANCE_LIMIT": "300",
    "RATE_LIMIT_INSTANCE_PERIOD_SECONDS": "60",
    "RATE_LIMIT_PRINCIPAL_LIMIT": "120",
    "RATE_LIMIT_PRINCIPAL_PERIOD_SECONDS": "60",
    "RATE_LIMIT_UNAUTHENTICATED_SENSITIVE_LIMIT": "30",
    "RATE_LIMIT_UNAUTHENTICATED_SENSITIVE_PERIOD_SECONDS": "60",
    "RATE_LIMIT_ANONYMOUS_LOGIN_LIMIT": "10",
    "RATE_LIMIT_ANONYMOUS_LOGIN_PERIOD_SECONDS": "60",
    "RATE_LIMIT_EXPENSIVE_READ_LIMIT": "10",
    "RATE_LIMIT_EXPENSIVE_READ_PERIOD_SECONDS": "60"
  },
  "ratelimits": [
    {
      "name": "PRINCIPAL_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 120,
        "period": 60
      }
    },
    {
      "name": "INSTANCE_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 300,
        "period": 60
      }
    },
    {
      "name": "UNAUTHENTICATED_RATE_LIMITER",
      "namespace_id": "1003",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      "name": "ANONYMOUS_LOGIN_RATE_LIMITER",
      "namespace_id": "1004",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "EXPENSIVE_READ_RATE_LIMITER",
      "namespace_id": "1005",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ]
}
