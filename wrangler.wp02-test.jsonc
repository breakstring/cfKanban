{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cfkanban-wp02-test",
  "main": "apps/worker/src/index.ts",
  "compatibility_date": "2026-08-29",
  "assets": {
    "directory": "./apps/web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/healthz",
      "/openapi.json",
      "/invite",
      "/",
      "/app",
      "/app/*",
      "/.well-known/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cfkanban-wp02-test",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "RATE_LIMIT_INSTANCE_LIMIT": "10000",
    "RATE_LIMIT_INSTANCE_PERIOD_SECONDS": "60",
    "RATE_LIMIT_PRINCIPAL_LIMIT": "10000",
    "RATE_LIMIT_PRINCIPAL_PERIOD_SECONDS": "60",
    "RATE_LIMIT_UNAUTHENTICATED_SENSITIVE_LIMIT": "10000",
    "RATE_LIMIT_UNAUTHENTICATED_SENSITIVE_PERIOD_SECONDS": "60"
  },
  "ratelimits": [
    {
      "name": "PRINCIPAL_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10000, "period": 60 }
    },
    {
      "name": "INSTANCE_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 10000, "period": 60 }
    },
    {
      "name": "UNAUTHENTICATED_RATE_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 10000, "period": 60 }
    }
  ]
}
